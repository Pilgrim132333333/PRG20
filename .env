ENVIRONMENT=development

DEBUG=true
RELOAD=true

# ========== MySQL（FastAPI 使用此项）==========
# fastapi-backend/app/config.py 会读取 DB_*，未设置时用 DATABASE_* 默认值。
# 密码含特殊字符时建议用双引号包起来；代码里会对账号密码做 URL 编码。
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="G20050428g!"
DB_NAME=pga_platform
DB_CHARSET=utf8mb4

# 若不用 DB_*，可改用下面一组（与上面二选一即可）：
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=你的密码
# DATABASE_NAME=pga_platform

# ========== 以下整段 URL 不会被 FastAPI 读取 ==========
# 仅保留给其它脚本或团队参考；后端实际连接只看上面的 DB_* / DATABASE_*。
# DATABASE_URL=mysql+aiomysql://team_dev:grp20@192.168.56.1:3306/study_resources?charset=utf8mb4
# SYNC_DATABASE_URL=mysql+pymysql://team_dev:grp20@192.168.56.1:3306/study_resources?charset=utf8mb4